config xiaozhi-api 'main'
	option token 'change-me'
	# 控制类总开关：默认 0(关闭)。所有写操作的总闸
	option allow_control '0'

# 每个控制功能独立开关，默认全部 0(关闭)，要用哪个就单独改 1
# 端口映射（写 firewall 规则）
config permission 'portforward'
	option allow '0'

# 查看映射（只读，风险低，但也可关）
config permission 'portforward_list'
	option allow '0'

# 静态路由：添加（写 network，需总开关）
config permission 'route_add'
	option allow '0'

# 静态路由：删除（写 network，需总开关）
config permission 'route_del'
	option allow '0'

# 静态路由：查看（只读）
config permission 'route_list'
	option allow '1'

# 查询类功能开关（只读），默认 1 开放；不想让小智查就改 0
config permission 'clients'
	option allow '1'

config permission 'wan'
	option allow '1'

config permission 'status'
	option allow '1'

# 网络体检（只读，汇总 WAN/外网/DNS/负载/内存/在线设备）
config permission 'health'
	option allow '1'

# 设备名映射：MAC = 友好名。识别不出时用这里的名字
# 格式: list name_map 'MAC=名字'（MAC 小写，冒号分隔）
config name_map
	option mac 'aa:bb:cc:dd:ee:ff'
	option name '客厅电视'

config name_map
	option mac '11:22:33:44:55:66'
	option name '手机-张三'
