#!/bin/sh
# OpenWrt 路由器状态 HTTP API —— 给 ESP32(小智) 调用
# 部署: 传到 /www/cgi-bin/routerapi 并 chmod +x
# 调用: http://路由器IP/cgi-bin/routerapi?action=clients

printf 'Content-Type: application/json; charset=utf-8\r\n\r\n'

# 简单 token 鉴权（可选）：配置里 option token 非空时校验 ?token=
expect_token=$(uci -q get xiaozhi-api.main.token 2>/dev/null)
if [ -n "$expect_token" ] && [ "$expect_token" != "change-me" ]; then
    got_token=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*token=\([^&]*\).*/\1/p')
    if [ "$got_token" != "$expect_token" ]; then
        printf '{"error":"unauthorized"}\n'
        exit 0
    fi
fi

json_escape() {
    # 先剔除控制字符(CR/LF/TAB等)，避免产出非法 JSON
    printf '%s' "$1" | tr -d '\r\n\t' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# 从 query string 取参数
# 注：固件传参时 CIDR 里的 / 不编码（合法），此处不做 URL 解码以保持兼容
get_param() {
    printf '%s' "$QUERY_STRING" | sed -n "s/.*$1=\([^&]*\).*/\1/p"
}

# IP 合法性校验
valid_ip() {
    local ip="$1" o1 o2 o3 o4 rest
    o1=${ip%%.*}; rest=${ip#*.}
    o2=${rest%%.*}; rest=${rest#*.}
    o3=${rest%%.*}; o4=${rest##*.}
    for o in "$o1" "$o2" "$o3" "$o4"; do
        case "$o" in ''|*[!0-9]*) return 1 ;; esac
        [ "$o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

# 端口合法性校验
valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

# CIDR 网段校验：192.168.2.0/24，掩码位 8-32
valid_cidr() {
    local cidr="$1" ip mask
    case "$cidr" in */*) ;; *) return 1 ;; esac
    ip=${cidr%%/*}; mask=${cidr##*/}
    case "$mask" in ''|*[!0-9]*) return 1 ;; esac
    [ "$mask" -ge 8 ] 2>/dev/null && [ "$mask" -le 32 ] 2>/dev/null || return 1
    valid_ip "$ip"
}

# 掩码位数 -> 点分十进制，如 24 -> 255.255.255.0
netmask_from_prefix() {
    local bits="$1" i b full=0
    [ "$bits" -ge 8 ] 2>/dev/null && [ "$bits" -le 32 ] 2>/dev/null || return 1
    for i in 1 2 3 4; do
        if [ "$bits" -ge 8 ]; then b=255; bits=$((bits-8))
        elif [ "$bits" -gt 0 ]; then
            b=$(( (256 - 2**(8-bits)) & 255 )); bits=0
        else b=0; fi
        if [ "$i" -eq 1 ]; then full=$b
        else full="$full.$b"; fi
    done
    printf '%s' "$full"
}

# 总开关
control_enabled() {
    [ "$(uci -q get xiaozhi-api.main.allow_control 2>/dev/null)" = "1" ]
}

# 单个功能开关：config permission '名字' 里 option allow
# 第二参数=缺省值：查询类缺省允许(1)，控制类缺省拒绝(0)
func_enabled() {
    local v
    v=$(uci -q get "xiaozhi-api.$1.allow" 2>/dev/null)
    [ -n "$v" ] && [ "$v" = "1" ] && return 0
    [ -z "$v" ] && [ "${2:-0}" = "1" ] && return 0
    return 1
}

# 控制类：总开关 + 功能开关(缺省拒绝)
can_do() {
    control_enabled && func_enabled "$1" 0
}

# 查询类：只看功能开关(缺省允许)，不受总开关影响
can_read() {
    func_enabled "$1" 1
}

# 按 MAC 前3字节查厂商（OUI 库）
lookup_oui() {
    local mac="$1" prefix org
    prefix=$(printf '%s' "$mac" | tr -d ':-' | cut -c1-6 | tr 'A-Z' 'a-z')
    [ -f /tmp/oui.csv ] || return 1
    org=$(grep -m1 "^$prefix," /tmp/oui.csv 2>/dev/null | cut -d, -f2- | tr -d '\r')
    [ -n "$org" ] && printf '%s' "$org"
}

# 解析设备名：映射表 → DHCP 主机名 → OUI 厂商 → MAC
resolve_name() {
    local mac="$1" dhcp_name="$2" name="" s sm sn org
    # 1. UCI 映射表
    for s in $(uci -q show xiaozhi-api 2>/dev/null | sed -n 's/^\(xiaozhi-api\.@name_map\[[0-9]*\]\)\.mac=.*/\1/p'); do
        sm=$(uci -q get "$s.mac" 2>/dev/null)
        sn=$(uci -q get "$s.name" 2>/dev/null)
        if [ "$sm" = "$mac" ] && [ -n "$sn" ]; then
            name="$sn"
            break
        fi
    done
    # 2. DHCP 主机名
    if [ -z "$name" ]; then
        case "$dhcp_name" in
            ''|'*'|unknown|UNKNOWN) ;;
            *) name="$dhcp_name" ;;
        esac
    fi
    # 3. OUI 厂商
    if [ -z "$name" ]; then
        org=$(lookup_oui "$mac")
        [ -n "$org" ] && name="$org"
    fi
    # 4. 最后用 MAC
    [ -z "$name" ] && name="$mac"
    printf '%s' "$name"
}

action=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*action=\([^&]*\).*/\1/p')
[ -z "$action" ] && action=status

case "$action" in
    clients)
        if ! can_read clients; then printf '{"error":"clients disabled"}'; exit 0; fi
        # 在线设备: 读 ARP 表 —— 静态 IP 设备不在 DHCP 租约里，ARP 里都有
        printf '{"clients":['
        first=1
        # 表头跳过；Flags=0x2 表示邻居可达；取 IP($1) 和 MAC($4)
        awk 'NR>1 && $3=="0x2" {print $1, $4}' /proc/net/arp 2>/dev/null | while read -r ip mac; do
            [ "$mac" = "00:00:00:00:00:00" ] && continue
            mac_lc=$(printf '%s' "$mac" | tr 'A-Z' 'a-z')
            # 从 DHCP 租约补 hostname（静态 IP 设备没有，就靠映射表或 MAC）
            dhcp_name=$(awk -v m="$mac_lc" '$2 && tolower($2)==m && $4!="*" && $4!="" {print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
            friendly=$(resolve_name "$mac_lc" "$dhcp_name")
            [ $first -eq 0 ] && printf ','
            first=0
            printf '{"mac":"%s","ip":"%s","name":"%s"}' \
                "$(json_escape "$mac_lc")" "$(json_escape "$ip")" "$(json_escape "$friendly")"
        done
        printf ']}'
        ;;
    wan)
        if ! can_read wan; then printf '{"error":"wan disabled"}'; exit 0; fi
        # WAN 状态: ifstatus + jsonfilter (没装就 opkg install jsonfilter)
        ip=$(ifstatus wan 2>/dev/null | jsonfilter -e '@.ipaddr[0].address' 2>/dev/null)
        gw=$(ifstatus wan 2>/dev/null | jsonfilter -e '@.routes[0].nexthop' 2>/dev/null)
        printf '{"ip":"%s","gateway":"%s"}' \
            "$(json_escape "$ip")" "$(json_escape "$gw")"
        ;;
    status)
        if ! can_read status; then printf '{"error":"status disabled"}'; exit 0; fi
        uptime=$(cut -d. -f1 /proc/uptime 2>/dev/null)
        model=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//')
        printf '{"uptime":%s,"model":"%s"}' "$uptime" "$(json_escape "$model")"
        ;;
    health)
        # 网络体检（只读）：WAN / 外网 / DNS / 网关 / 负载 / 内存 / 在线设备 / 连接数
        if ! can_read health; then printf '{"error":"health disabled"}'; exit 0; fi

        wan_up=0; wan_ip=""; wan_gw=""
        wan_json=$(ifstatus wan 2>/dev/null)
        [ "$(printf '%s' "$wan_json" | jsonfilter -e '@.up' 2>/dev/null)" = "true" ] && wan_up=1
        wan_ip=$(printf '%s' "$wan_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
        [ -n "$wan_ip" ] || wan_ip=$(printf '%s' "$wan_json" | jsonfilter -e '@["ipaddr"][0].address' 2>/dev/null)
        wan_gw=$(printf '%s' "$wan_json" | jsonfilter -e '@.routes[0].nexthop' 2>/dev/null)
        if [ -z "$wan_gw" ] || [ "$wan_gw" = "0.0.0.0" ]; then
            wan_gw=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
        fi

        uptime_s=$(cut -d. -f1 /proc/uptime 2>/dev/null); [ -n "$uptime_s" ] || uptime_s=0
        load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)
        load1=$(printf '%s' "$load" | cut -d' ' -f1)
        cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
        [ -n "$cores" ] && [ "$cores" -gt 0 ] 2>/dev/null || cores=1
        mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
        mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
        [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ] 2>/dev/null || mem_total=1
        [ -n "$mem_avail" ] || mem_avail=0
        mem_used_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))

        ct_count=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null); [ -n "$ct_count" ] || ct_count=0
        ct_max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null); [ -n "$ct_max" ] || ct_max=0

        # 在线设备：ARP 可达条目；未命名 = 既不在 name_map，也没有 DHCP hostname
        arp_entries=$(awk 'NR>1 && $3=="0x2" && $4!="00:00:00:00:00:00" {print $1" "$4}' /proc/net/arp 2>/dev/null)
        online=$(printf '%s\n' "$arp_entries" | grep -c .)
        map_macs=$(uci -q show xiaozhi-api 2>/dev/null | sed -n 's/^xiaozhi-api\.@name_map\[[0-9]*\]\.mac=//p' | tr -d "'\r" | tr 'A-Z' 'a-z')
        unknown=$(printf '%s\n' "$arp_entries" | while read -r cip cmac; do
            [ -n "$cmac" ] || continue
            cmac_lc=$(printf '%s' "$cmac" | tr 'A-Z' 'a-z')
            known=0
            case " $map_macs " in *" $cmac_lc "*) known=1 ;; esac
            dhcp_name=$(awk -v m="$cmac_lc" '$2 && tolower($2)==m && $4!="*" && $4!="" {print $4; exit}' /tmp/dhcp.leases 2>/dev/null)
            if [ "$known" -eq 0 ] && [ -z "$dhcp_name" ]; then echo x; fi
        done | wc -l | tr -d ' ')

        # 三项耗时检查并发跑，整体控制在 3 秒内
        tmp=$(mktemp -d /tmp/xzhealth.XXXXXX 2>/dev/null) || tmp="/tmp/xzhealth.$$"
        mkdir -p "$tmp" 2>/dev/null
        (ping -c 2 -W 1 -q 223.5.5.5 >"$tmp/net" 2>&1) &
        net_pid=$!
        gw_pid=""
        if valid_ip "$wan_gw"; then
            (ping -c 2 -W 1 -q "$wan_gw" >"$tmp/gw" 2>&1) &
            gw_pid=$!
        fi
        (nslookup -type=a www.baidu.com >"$tmp/dns" 2>&1) &
        dns_pid=$!
        wait "$net_pid" 2>/dev/null
        [ -n "$gw_pid" ] && wait "$gw_pid" 2>/dev/null
        # BusyBox 没有 timeout 命令；nslookup 用 3 秒看门狗兜底
        dns_wait=0
        while kill -0 "$dns_pid" 2>/dev/null && [ "$dns_wait" -lt 3 ]; do
            sleep 1
            dns_wait=$((dns_wait + 1))
        done
        kill -0 "$dns_pid" 2>/dev/null && kill -9 "$dns_pid" 2>/dev/null
        wait "$dns_pid" 2>/dev/null

        net_out=$(cat "$tmp/net" 2>/dev/null)
        net_loss=$(printf '%s' "$net_out" | sed -n 's/.*, \([0-9][0-9]*\)% packet loss.*/\1/p' | head -1)
        [ -n "$net_loss" ] || net_loss=100
        net_avg=$(printf '%s' "$net_out" | sed -n 's/.*round-trip min\/avg\/max = [^/]*\/\([0-9.]*\)\/.*/\1/p' | head -1)
        [ -n "$net_avg" ] || net_avg=-1

        gw_loss=100; gw_avg=-1
        if [ -n "$gw_pid" ]; then
            gw_out=$(cat "$tmp/gw" 2>/dev/null)
            gw_loss=$(printf '%s' "$gw_out" | sed -n 's/.*, \([0-9][0-9]*\)% packet loss.*/\1/p' | head -1)
            [ -n "$gw_loss" ] || gw_loss=100
            gw_avg=$(printf '%s' "$gw_out" | sed -n 's/.*round-trip min\/avg\/max = [^/]*\/\([0-9.]*\)\/.*/\1/p' | head -1)
            [ -n "$gw_avg" ] || gw_avg=-1
        fi

        dns_ok=0
        grep -q 'Name:' "$tmp/dns" 2>/dev/null && dns_ok=1
        rm -rf "$tmp" 2>/dev/null

        # 评分：只对真实异常扣分；未命名设备只提示，不扣分
        score=100; issues_json=""; grade="poor"; grade_text="较差"
        add_issue() {
            esc=$(json_escape "$1")
            if [ -z "$issues_json" ]; then issues_json="\"$esc\""; else issues_json="$issues_json,\"$esc\""; fi
        }

        if [ "$wan_up" != "1" ]; then
            score=$((score-35)); add_issue "WAN 未连接"; wan_status="error"
        elif [ -z "$wan_ip" ]; then
            score=$((score-20)); add_issue "WAN 已连接但未获取 IP"; wan_status="warn"
        else
            wan_status="ok"
        fi

        if [ "$net_loss" -ge 100 ] 2>/dev/null; then
            if [ "$dns_ok" -eq 1 ]; then
                score=$((score-6)); add_issue "ICMP 无响应，但 DNS 正常"; net_status="warn"
            else
                score=$((score-30)); add_issue "外网不可达"; net_status="error"
            fi
        elif [ "$net_loss" -gt 0 ] 2>/dev/null; then
            score=$((score-6)); add_issue "外网丢包 ${net_loss}%"; net_status="warn"
        else
            net_status="ok"
        fi

        if [ "$dns_ok" -eq 1 ]; then dns_status="ok"; else
            score=$((score-8)); add_issue "DNS 解析失败"; dns_status="warn"
        fi

        if [ -z "$wan_gw" ]; then
            gw_status="unknown"
        elif [ "$gw_loss" -ge 100 ] 2>/dev/null; then
            score=$((score-4)); add_issue "网关无响应"; gw_status="warn"
        else
            gw_status="ok"
        fi

        load_high=$(awk -v l="$load1" -v c="$cores" 'BEGIN{print (l > c) ? 1 : 0}' 2>/dev/null)
        if [ "$load_high" = "1" ]; then
            score=$((score-8)); add_issue "系统负载偏高"; load_status="warn"
        else
            load_status="ok"
        fi

        mem_free_pct=$((100 - mem_used_pct))
        if [ "$mem_free_pct" -lt 10 ]; then
            score=$((score-10)); add_issue "内存紧张，仅剩 ${mem_free_pct}%"; mem_status="error"
        elif [ "$mem_free_pct" -lt 20 ]; then
            score=$((score-5)); add_issue "内存偏低，剩 ${mem_free_pct}%"; mem_status="warn"
        else
            mem_status="ok"
        fi
        sys_status="ok"
        [ "$load_status" = "warn" ] && sys_status="warn"
        [ "$mem_status" = "error" ] && sys_status="error"
        [ "$mem_status" = "warn" ] && [ "$sys_status" != "error" ] && sys_status="warn"

        ct_pct=0
        if [ "$ct_max" -gt 0 ] 2>/dev/null; then
            ct_pct=$(awk -v c="$ct_count" -v m="$ct_max" 'BEGIN{printf "%.0f", c * 100 / m}' 2>/dev/null)
            [ -n "$ct_pct" ] || ct_pct=0
            if [ "$ct_pct" -ge 90 ]; then
                score=$((score-8)); add_issue "连接数接近上限 ${ct_pct}%"; ct_status="warn"
            elif [ "$ct_pct" -ge 70 ]; then
                score=$((score-4)); add_issue "连接数偏高 ${ct_pct}%"; ct_status="warn"
            else
                ct_status="ok"
            fi
        else
            ct_status="unknown"
        fi

        if [ "$unknown" -gt 0 ]; then
            clients_status="warn"; add_issue "${unknown} 台设备未命名"
        else
            clients_status="ok"
        fi

        [ "$score" -lt 0 ] && score=0
        if [ "$score" -ge 90 ]; then grade="excellent"; grade_text="优秀"
        elif [ "$score" -ge 75 ]; then grade="good"; grade_text="良好"
        elif [ "$score" -ge 60 ]; then grade="fair"; grade_text="一般"
        fi

        summary="$grade_text"
        if [ "$wan_up" = "1" ] && [ "$net_loss" -lt 100 ] && [ "$net_avg" != "-1" ]; then
            summary="$summary，外网延迟 ${net_avg}ms"
        fi
        summary="$summary，在线 ${online} 台"
        [ "$unknown" -gt 0 ] && summary="$summary，${unknown} 台未命名"
        wan_up_json=false; [ "$wan_up" = "1" ] && wan_up_json=true

        printf '{"score":%d,"grade":"%s","grade_text":"%s","summary":"%s","checks":{"wan":{"status":"%s","up":%s,"ip":"%s","gateway":"%s"},"internet":{"status":"%s","loss":%d,"latency_ms":%s},"dns":{"status":"%s"},"gateway_ping":{"status":"%s","latency_ms":%s},"system":{"status":"%s","uptime":%d,"load":"%s","cores":%d,"mem_used_pct":%d},"clients":{"status":"%s","online":%d,"unknown":%d},"conntrack":{"status":"%s","count":%d,"max":%d,"pct":%d}},"issues":[%s]}\n' \
            "$score" "$grade" "$grade_text" "$(json_escape "$summary")" \
            "$wan_status" "$wan_up_json" "$(json_escape "$wan_ip")" "$(json_escape "$wan_gw")" \
            "$net_status" "$net_loss" "$net_avg" "$dns_status" "$gw_status" "$gw_avg" \
            "$sys_status" "$uptime_s" "$(json_escape "$load")" "$cores" "$mem_used_pct" \
            "$clients_status" "$online" "$unknown" "$ct_status" "$ct_count" "$ct_max" "$ct_pct" "$issues_json"
        ;;
    portforward)
        # 端口映射（控制类）：需总开关 + portforward 开关同时打开
        if ! can_do portforward; then
            printf '{"error":"portforward disabled, set allow_control=1 and permission.portforward.allow=1"}'
            exit 0
        fi
        ext=$(get_param ext); dst_ip=$(get_param ip); inner=$(get_param in); confirm=$(get_param confirm)

        valid_port "$ext" || { printf '{"error":"invalid external port"}'; exit 0; }
        valid_port "$inner" || { printf '{"error":"invalid internal port"}'; exit 0; }
        valid_ip "$dst_ip" || { printf '{"error":"invalid ip"}'; exit 0; }

        # 确认码 = 三个参数的校验和（本机算，不存状态）
        sig=$(printf '%s:%s:%s' "$ext" "$dst_ip" "$inner" | md5sum | cut -c1-8)

        if [ "$confirm" != "$sig" ]; then
            # 第一步：返回预览 + 确认码，不执行
            printf '{"need_confirm":true,"confirm":"%s","desc":"map WAN port %s to %s:%s"}' \
                "$sig" "$ext" "$dst_ip" "$inner"
            exit 0
        fi

        # 第二步：带正确确认码，真正执行
        name="xiaozhi_${ext}"
        uci -q delete "firewall.$name" 2>/dev/null
        uci set "firewall.$name=redirect"
        uci set "firewall.$name.name=$name"
        uci set "firewall.$name.target=DNAT"
        uci set "firewall.$name.src=wan"
        uci set "firewall.$name.src_dport=$ext"
        # 关键：dest=lan 表示转发到内网设备；缺失会变成"到此设备(本机)"而非 DNAT 转发
        uci set "firewall.$name.dest=lan"
        uci set "firewall.$name.dest_ip=$dst_ip"
        uci set "firewall.$name.dest_port=$inner"
        uci set "firewall.$name.proto=tcpudp"
        uci commit firewall
        /etc/init.d/firewall restart >/dev/null 2>&1
        printf '{"result":"ok","desc":"WAN %s -> %s:%s"}' "$ext" "$dst_ip" "$inner"
        ;;
    portforward_list)
        # 列出所有端口转发规则（需 portforward_list 开关）
        if ! can_do portforward_list; then
            printf '{"error":"portforward_list disabled"}'; exit 0
        fi
        # 注意：uci show 输出为 firewall.<section>.target='DNAT'（值带引号），
        # 不能用 .target=DNAT 匹配；改为逐行解析 .target= 后去引号判断
        uci -q show firewall 2>/dev/null | grep '\.target=' | while IFS='=' read -r key val; do
            [ "$val" = "'DNAT'" ] || continue
            sect=${key%.*}
            name=$(uci -q get "$sect.name" 2>/dev/null)
            ext=$(uci -q get "$sect.src_dport" 2>/dev/null)
            ipx=$(uci -q get "$sect.dest_ip" 2>/dev/null)
            inn=$(uci -q get "$sect.dest_port" 2>/dev/null)
            # 跳过无外部端口的（DNAT 也可能用于其他用途）
            [ -n "$ext" ] || continue
            printf '{"name":"%s","ext":"%s","ip":"%s","in":"%s"}\n' \
                "$(json_escape "$name")" "$(json_escape "$ext")" \
                "$(json_escape "$ipx")" "$(json_escape "$inn")"
        done | awk 'BEGIN{printf "{\"forwards\":["} {if(n++)printf ","; printf "%s",$0} END{printf "]}"}'
        ;;
    route_list)
        # 列出静态路由（查询类）
        if ! can_read route_list; then printf '{"error":"route_list disabled"}'; exit 0; fi
        uci -q show network 2>/dev/null | grep '\.target=' | while IFS='=' read -r key val; do
            sect=${key%.*}
            case "$sect" in network.*) ;; *) continue ;; esac
            target=$(echo "$val" | tr -d "'")
            gw=$(uci -q get "$sect.gateway" 2>/dev/null)
            mask=$(uci -q get "$sect.netmask" 2>/dev/null)
            [ -n "$target" ] || continue
            printf '{"section":"%s","target":"%s","gateway":"%s","netmask":"%s"}\n' \
                "$(json_escape "${sect#network.}")" "$(json_escape "$target")" \
                "$(json_escape "$gw")" "$(json_escape "$mask")"
        done | awk 'BEGIN{printf "{\"routes\":["} {if(n++)printf ","; printf "%s",$0} END{printf "]}"}'
        ;;
    route_add)
        # 添加静态路由（控制类，二次确认）：cidr=目标网段 gw=网关 confirm=确认码
        if ! can_do route_add; then
            printf '{"error":"route_add disabled, set allow_control=1 and permission.route_add.allow=1"}'
            exit 0
        fi
        cidr=$(get_param cidr); gw=$(get_param gw); confirm=$(get_param confirm)
        valid_cidr "$cidr" || { printf '{"error":"invalid cidr"}'; exit 0; }
        valid_ip "$gw" || { printf '{"error":"invalid gateway"}'; exit 0; }
        sig=$(printf '%s:%s' "$cidr" "$gw" | md5sum | cut -c1-8)
        if [ "$confirm" != "$sig" ]; then
            printf '{"need_confirm":true,"confirm":"%s","desc":"add route %s via %s"}' \
                "$sig" "$cidr" "$gw"
            exit 0
        fi
        # 把 CIDR 拆成 target + netmask（UCI route 格式）
        target=${cidr%%/*}; bits=${cidr##*/}
        mask=$(netmask_from_prefix "$bits")
        [ -n "$mask" ] || { printf '{"error":"invalid netmask"}'; exit 0; }
        name="xiaozhi_route_$(printf '%s' "$cidr" | tr './' '__')"
        uci -q delete "network.$name" 2>/dev/null
        uci set "network.$name=route"
        uci set "network.$name.target=$target"
        uci set "network.$name.netmask=$mask"
        uci set "network.$name.gateway=$gw"
        uci commit network
        /etc/init.d/network reload >/dev/null 2>&1
        printf '{"result":"ok","desc":"route %s via %s"}' "$target" "$gw"
        ;;
    route_del)
        # 删除静态路由（控制类，二次确认）：cidr=目标网段 confirm=确认码
        if ! can_do route_del; then
            printf '{"error":"route_del disabled"}'; exit 0
        fi
        cidr=$(get_param cidr); confirm=$(get_param confirm)
        valid_cidr "$cidr" || { printf '{"error":"invalid cidr"}'; exit 0; }
        sig=$(printf 'del:%s' "$cidr" | md5sum | cut -c1-8)
        if [ "$confirm" != "$sig" ]; then
            printf '{"need_confirm":true,"confirm":"%s","desc":"delete route %s"}' "$sig" "$cidr"
            exit 0
        fi
        name="xiaozhi_route_$(printf '%s' "$cidr" | tr './' '__')"
        if [ -z "$(uci -q get "network.$name.target" 2>/dev/null)" ]; then
            printf '{"error":"route not found"}'; exit 0
        fi
        uci -q delete "network.$name"
        uci commit network
        /etc/init.d/network reload >/dev/null 2>&1
        printf '{"result":"ok","desc":"deleted route %s"}' "$cidr"
        ;;
    *)
        printf '{"error":"unknown action"}'
        ;;
esac
